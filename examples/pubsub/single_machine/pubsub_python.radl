settings : module_settings {
    MODULE_BASE_PATH "src"
}

basic_rate : duration 500msec

chatter_data : topic {
    FIELDS
        data : int64 0
}

# Example pip package declarations (optional - uncomment to use)
# numpy_pkg : pip_package { PACKAGE "numpy" VERSION ">=1.20" }
# requests_pkg : pip_package { PACKAGE "requests" }

talker : node {
    PUBLISHES
        chatter { TOPIC chatter_data }
    PERIOD basic_rate
    PYTHON { FILENAME "talker.py" MODULE "talker" CLASS "Talker" }
    # To add pip dependencies, add: LIB numpy_pkg requests_pkg
}

listener : node {
    SUBSCRIBES
        chatter { TOPIC chatter_data MAXLATENCY 100msec }
    PERIOD basic_rate
    PYTHON { FILENAME "listener.py" MODULE "listener" CLASS "Listener" }
}

sys1 : linux {
  NODES_UID 1000
  IMG "linux.img"
  IP 192.168.10.201
  NODES
   talker listener 
}

plant : plant {
  MACHINES
    host_computer { OS sys1 }
}

