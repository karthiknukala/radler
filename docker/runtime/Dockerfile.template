# Radler Runtime Container Template
# This template is used by Radler to generate per-node Dockerfiles.
# Variables are substituted by Radler's Docker generator:
#   {{NODE_NAME}}     - Name of the node (e.g., talker, listener)
#   {{PACKAGE_NAME}}  - Name of the ROS package
#   {{ROS_DISTRO}}    - ROS distribution (e.g., jazzy)
#   {{NODE_IP}}       - IP address assigned to this node (optional)
#   {{ROS_DOMAIN_ID}} - ROS domain ID for network isolation (optional)

FROM ros:{{ROS_DISTRO}}-ros-core

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Copy the built package
COPY install/{{PACKAGE_NAME}} /opt/ros_ws/install/{{PACKAGE_NAME}}
COPY install/radl_lib /opt/ros_ws/install/radl_lib

# Setup environment
ENV ROS_DOMAIN_ID={{ROS_DOMAIN_ID}}
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Create entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
source /opt/ros/{{ROS_DISTRO}}/setup.bash\n\
source /opt/ros_ws/install/{{PACKAGE_NAME}}/local_setup.bash\n\
exec "$@"' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/opt/ros_ws/install/{{PACKAGE_NAME}}/lib/{{PACKAGE_NAME}}/{{NODE_NAME}}"]

